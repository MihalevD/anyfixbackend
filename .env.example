# AnyFix Backend – .env.example
# Copy as `.env` (local) or set as environment variables in Railway/Render.
# REQUIRED entries are marked. The rest can be left blank for v1 — those features
# will simply log "skipped" instead of running.

# ─── REQUIRED ────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / Railway-managed PG).
DATABASE_URL="postgresql://user:password@host:5432/anyfix"

# 64-char random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING"

# Public URL of your Vercel frontend, no trailing slash.
FRONTEND_URL="https://your-frontend.vercel.app"

NODE_ENV="production"
PORT=4000

# ─── OPTIONAL — leave blank to skip the feature ──────────

# Redis (Upstash). If unset the API uses an in-memory store
# (fine for single-instance v1; not safe for multiple replicas).
REDIS_URL=""

# CORS — comma-separated extra origins (e.g. preview deploys).
ADDITIONAL_ORIGINS=""

# Stripe Connect (escrow payments). Without these, payment endpoints will 500.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AWS S3 (file uploads – verification docs, portfolio, photos).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_BUCKET_NAME=""

# Firebase Admin (push notifications). PRIVATE_KEY needs literal \n preserved.
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# SendGrid (transactional emails). Without this, emails are logged not sent.
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@anyfix.bg"
FROM_NAME="AnyFix"

# Twilio (OTP / SMS). Without this, OTPs are logged not sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Admin notifications recipient.
ADMIN_EMAIL="admin@anyfix.bg"
TRUST_SAFETY_EMAIL="trust@anyfix.bg"
