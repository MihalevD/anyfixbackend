# AnyFix Backend – .env.example
# Копирай като .env и попълни стойностите

# ─── DATABASE ─────────────────────────────────────────────
DATABASE_URL="postgresql://anyfix:password@localhost:5432/anyfix_db"

# ─── REDIS ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────────
# Генерирай с: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="СМЕНИ_С_64_СИМВОЛЕН_RANDOM_STRING"
JWT_REFRESH_SECRET="СМЕНИ_С_РАЗЛИЧЕН_64_СИМВОЛЕН_RANDOM_STRING"

# ─── STRIPE ───────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── AWS S3 ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="eu-west-1"
AWS_BUCKET_NAME="anyfix-uploads"

# ─── FIREBASE ADMIN ───────────────────────────────────────
FIREBASE_PROJECT_ID="anyfix-prod"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@anyfix-prod.iam.gserviceaccount.com"

# ─── SENDGRID ─────────────────────────────────────────────
SENDGRID_API_KEY="SG...."
FROM_EMAIL="noreply@anyfix.bg"
FROM_NAME="AnyFix"

# ─── TWILIO (SMS / OTP) ───────────────────────────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# ─── APP ──────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
TRUST_SAFETY_EMAIL="trust@anyfix.bg"
